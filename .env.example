# Copy to .env and fill in real values

DB_HOST=db
DB_USER=user
DB_PASSWORD=change-me
DB_NAME=mtb_db
DB_PORT=3306

# In-container path used by the app (also used for volume mount)
DIR_PATH=/app/MTB_WGS_cluster_analysis

# Frontend/runtime config
NEXT_PUBLIC_APP_ENV=docker
NEXT_PUBLIC_API_URL_PROD=http://localhost:3001

# Auth
JWT_SECRET=change-me

# SMTP / email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password
SMTP_FROM=your-email-from

# docker-compose parameters
MYSQL_ROOT_PASSWORD=change-me
APP_PORT=3000
API_PORT=3001
MTB_ANALYSIS_DIR_HOST=./MTB_WGS_cluster_analysis
